# Example configuration for the WhatsApp MCP bridge and server.
# Neither component loads this file automatically: export the variables in your
# shell (e.g. `set -a; source .env; set +a`) before starting the bridge, and put
# the MCP server ones in the "env" block of your MCP client configuration.

# --- Shared --------------------------------------------------------------------
# Optional shared secret. When set, the bridge requires it on every REST API
# request and the MCP server sends it in the X-API-Key header.
# Generate one with: openssl rand -hex 32
WHATSAPP_BRIDGE_API_KEY=replace-with-a-long-random-string

# --- Go bridge (whatsapp-bridge) ---------------------------------------------
# Directory for whatsapp.db (session keys), messages.db and downloaded media.
WHATSAPP_BRIDGE_STORE_DIR=store
# Address of the REST API. Keep it on 127.0.0.1 unless you know what you're doing.
WHATSAPP_BRIDGE_ADDR=127.0.0.1:8080
# whatsmeow log level: DEBUG, INFO, WARN or ERROR.
WHATSAPP_BRIDGE_LOG_LEVEL=INFO

# --- Python MCP server (whatsapp-mcp-server) ---------------------------------
# Path to the bridge's messages.db (defaults to ../whatsapp-bridge/store/messages.db).
# WHATSAPP_DB_PATH=/absolute/path/to/whatsapp-mcp/whatsapp-bridge/store/messages.db
# Base URL of the bridge REST API.
WHATSAPP_API_BASE_URL=http://127.0.0.1:8080/api
# Timeout in seconds for requests to the bridge.
WHATSAPP_REQUEST_TIMEOUT=60
